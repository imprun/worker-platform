FROM --platform=$BUILDPLATFORM golang:1.27.4 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/echo ./cmd/echo
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/echo-worker ./cmd/echo

FROM scratch
COPY --from=build /out/echo-worker /usr/local/bin/echo-worker
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/echo-worker"]
