FROM --platform=$BUILDPLATFORM golang:1.27.4 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY examples/echo/standalone ./examples/echo/standalone
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/echo-worker ./examples/echo/standalone

FROM scratch
COPY --from=build /out/echo-worker /usr/local/bin/echo-worker
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/echo-worker"]
